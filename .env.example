# Server-only. Copy to .env.local for local work — never commit real values.

# Supabase (service-role key is used today for simple inserts only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@zyflow.eu
NOTIFICATION_EMAIL=

# MapTiler client key for the tour maps (the app's streets-v2 base map).
# Injected into the built js/tour-map.js at build time, so it is public:
# use the "web" key restricted to zyflow.eu, *.zyflow.eu, *.vercel.app and
# localhost. Set it in Vercel for Production and Preview. Leave it empty
# locally to get the OpenFreeMap fallback base map.
MAPTILER_KEY=

# Optional Cloudflare Turnstile.
# Verification is enforced only when TURNSTILE_SECRET_KEY is set.
# TURNSTILE_SITE_KEY is injected into the built site at build time;
# leave both unset to keep forms working without a widget.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Extra browser origins (comma-separated). Production otherwise allows only
# https://www.zyflow.eu and https://zyflow.eu plus localhost.
# Preview look-alikes such as zyflow-landing-evil.vercel.app are rejected.
# On Vercel preview, the deployment URL plus
# zyflow-landing-<hash>-jakobs-projects-48c1181f.vercel.app are also allowed.
# Override the team slug with VERCEL_PREVIEW_TEAM if it ever changes.
# ALLOWED_ORIGINS=
# VERCEL_PREVIEW_TEAM=

# Optional overrides for the in-memory form rate limiter (defaults: 8 / 10 minutes)
# FORM_RATE_LIMIT_MAX=8
# FORM_RATE_LIMIT_WINDOW_MS=600000

  <metadata>
    <name>Cycling route Zgornje Jezersko–Štularjeva planina–Zgornje Jezersko</name>
    <author>
      <name>Mateja Korošec - Karavanke Slovenia</name>
    </author>
    <link href="https://www.outdooractive.com/r/801694896"/>

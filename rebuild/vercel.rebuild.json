{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_comment": "Draft for rebuild cutover. Merge into root vercel.json when switching output to rebuild/dist.",
  "buildCommand": "npm run build:rebuild",
  "outputDirectory": "rebuild/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/legal-pages/privacy-policy",
      "destination": "/legal-privacy",
      "permanent": true
    },
    {
      "source": "/legal-pages/cookie-policy",
      "destination": "/legal-cookies",
      "permanent": true
    },
    {
      "source": "/legal-pages/terms-conditions",
      "destination": "/legal-terms",
      "permanent": true
    }
  ]
}

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getCollection } from "astro:content";
import { t } from "../../../lib/i18n";

const locale = "sl" as const;
const posts = (await getCollection("blog")).filter(
  (post) => post.data.locale === locale && !post.data.draft,
);
---

<BaseLayout
  locale={locale}
  path="blog"
  title={`${t(locale, "blog.title")} · Zyflow`}
  description={t(locale, "blog.empty")}
>
  <SiteHeader locale={locale} path="blog" />
  <main>
    <section class="blog-hero">
      <div class="zf-container">
        <h1>{t(locale, "blog.title")}</h1>
        {
          posts.length === 0 ? (
            <p>{t(locale, "blog.empty")}</p>
          ) : (
            <ul>
              {posts.map((post) => (
                <li>
                  <a href={`/sl/blog/${post.id}`}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .blog-hero {
    padding: 8rem 0 4rem;
  }
</style>

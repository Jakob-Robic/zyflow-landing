---
import type { Locale } from "../lib/i18n";
import { t } from "../lib/i18n";
import { STORE_URLS } from "../lib/stores";

interface Props {
  locale: Locale;
  size?: "hero" | "final";
}

const { locale, size = "hero" } = Astro.props;
---

<div class:list={["store-btns", size === "final" && "store-btns--final"]}>
  <a class="zf-btn zf-btn--dark" href={STORE_URLS.ios} target="_blank" rel="noopener noreferrer">
    <img src="/images/BZYkl56vzaLH9uCPqEid8uQg9ZE_42204b.svg" alt="" width="18" height="18" />
    {size === "hero" ? t(locale, "hero.cta.ios") : t(locale, "cta.final.ios")}
  </a>
  <a class="zf-btn zf-btn--light" href={STORE_URLS.android} target="_blank" rel="noopener noreferrer">
    <img src="/images/J4VPLNaOdWSrA6fBUpuZ0eLYNAI_8debd7.svg" alt="" width="18" height="18" />
    {size === "hero" ? t(locale, "hero.cta.android") : t(locale, "cta.final.android")}
  </a>
</div>

<style>
  .store-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .store-btns--final {
    justify-content: flex-start;
  }

  .store-btns img {
    filter: invert(1);
  }

  .store-btns .zf-btn--light img {
    filter: none;
  }
</style>

---
import type { Locale } from "../../lib/i18n";
import { localePath, t } from "../../lib/i18n";
import { STORE_URLS } from "../../lib/stores";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const tiers = [
  ["beta.tier1.title", "beta.tier1.desc"],
  ["beta.tier2.title", "beta.tier2.desc"],
  ["beta.tier3.title", "beta.tier3.desc"],
  ["beta.tier4.title", "beta.tier4.desc"],
] as const;
---

<section class="beta zf-section" id="beta">
  <div class="zf-container">
    <div class="beta__intro zf-reveal">
      <h2>{t(locale, "beta.title")}</h2>
      <p>{t(locale, "beta.subtitle")}</p>
    </div>

    <div class="beta__layout">
      <div class="beta__visual zf-reveal">
        <img src="/images/VAoFdW6jpH2DBISx4ta1C5pZw_06b922.webp" alt="" width="560" height="720" />
      </div>
      <div class="beta__grid">
        {
          tiers.map(([title, desc]) => (
            <article class="zf-reveal">
              <h3>{t(locale, title)}</h3>
              <p>{t(locale, desc)}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="beta__cta zf-reveal">
      <p>{t(locale, "beta.cta.body")}</p>
      <div class="beta__actions">
        <a class="zf-btn zf-btn--dark" href={STORE_URLS.ios} target="_blank" rel="noopener noreferrer">
          {t(locale, "beta.cta.plan")}
        </a>
        <a class="zf-btn zf-btn--cream" href={localePath(locale, "contact")}>
          {t(locale, "beta.cta.contact")}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .beta {
    background: var(--zf-cream);
  }

  .beta__intro {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 2.5rem;
  }

  .beta__intro h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.04em;
  }

  .beta__intro p {
    color: var(--zf-ink-muted);
  }

  .beta__layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1.5rem;
    align-items: center;
  }

  .beta__visual img {
    width: 100%;
    border-radius: 28px;
    box-shadow: var(--zf-shadow);
  }

  .beta__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .beta__grid article {
    background: white;
    border-radius: 20px;
    padding: 1.2rem;
  }

  .beta__grid h3 {
    margin: 0 0 0.45rem;
  }

  .beta__grid p {
    margin: 0;
    color: var(--zf-ink-muted);
  }

  .beta__cta {
    margin-top: 2rem;
    text-align: center;
  }

  .beta__actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .beta__layout,
    .beta__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

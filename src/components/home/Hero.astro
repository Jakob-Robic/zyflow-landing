---
import type { Locale } from "../../lib/i18n";
import { t } from "../../lib/i18n";
import StoreButtons from "../StoreButtons.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <img
      src="/images/09xUvyJFvYJ1ravqtWEYsS31qo_d0c075.webp"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <div class="hero__shade"></div>
  </div>

  <div class="hero__content zf-container">
    <div class="hero__copy zf-reveal is-visible">
      <p class="zf-eyebrow">
        <span class="zf-badge">{t(locale, "hero.badge")}</span>
        <span class="hero__live">{t(locale, "hero.live")}</span>
      </p>
      <h1>{t(locale, "hero.headline")}</h1>
      <p class="hero__sub">{t(locale, "hero.subline")}</p>
      <StoreButtons locale={locale} />
    </div>

    <div class="hero__stage zf-reveal is-visible">
      <article class="hero-card">
        <div class="hero-card__icon" aria-hidden="true">⛰</div>
        <p>Your best elevation yet!</p>
      </article>
      <div class="hero-phone">
        <img src="/images/IrcfFLaKCkZH5a56AKdI2c44_ad959a.webp" alt="" width="320" height="640" />
      </div>
      <article class="hero-card hero-card--wide">
        <p class="hero-card__title">Today's ride: On track</p>
        <div class="hero-card__metrics">
          <span>47 km</span>
          <span>73%</span>
          <span>Good</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    color: white;
    overflow: clip;
    display: grid;
    align-items: end;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 20, 25, 0.35) 0%, rgba(15, 20, 25, 0.15) 35%, rgba(15, 20, 25, 0.55) 100%),
      radial-gradient(circle at 50% 20%, transparent 0%, rgba(0, 0, 0, 0.25) 70%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding: 7.5rem 0 3rem;
    display: grid;
    gap: 3rem;
  }

  .hero__copy {
    text-align: center;
    max-width: 46rem;
    margin-inline: auto;
  }

  .hero__live {
    color: rgba(255, 255, 255, 0.92);
  }

  .hero h1 {
    margin: 1rem 0 0.85rem;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 700;
  }

  .hero__sub {
    margin: 0 auto 1.6rem;
    max-width: 34rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__stage {
    display: grid;
    grid-template-columns: 0.9fr 1fr 1.1fr;
    gap: 1rem;
    align-items: end;
    animation: floaty 5.5s ease-in-out infinite;
  }

  .hero-card {
    background: rgba(20, 24, 28, 0.72);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 1.1rem;
    box-shadow: var(--zf-shadow);
  }

  .hero-card__icon {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--zf-orange);
    margin-bottom: 0.85rem;
  }

  .hero-card p {
    margin: 0;
    font-weight: 600;
  }

  .hero-card--wide .hero-card__title {
    margin-bottom: 0.85rem;
  }

  .hero-card__metrics {
    display: flex;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.92rem;
  }

  .hero-phone {
    justify-self: center;
    width: min(100%, 220px);
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--zf-shadow);
    border: 3px solid rgba(255, 255, 255, 0.7);
    background: #111;
  }

  .hero-phone img {
    width: 100%;
    height: auto;
  }

  @keyframes floaty {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 900px) {
    .hero__stage {
      grid-template-columns: 1fr;
      justify-items: center;
      animation: none;
    }

    .hero-card,
    .hero-card--wide {
      width: min(100%, 22rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__stage {
      animation: none;
    }
  }
</style>

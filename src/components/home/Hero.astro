---
import type { Locale } from "../../lib/i18n";
import { t } from "../../lib/i18n";
import StoreButtons from "../StoreButtons.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero" id="top">
  <div class="hero__media" aria-hidden="true">
    <img
      src="/images/09xUvyJFvYJ1ravqtWEYsS31qo_d0c075.webp"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <div class="hero__shade"></div>
    <div class="hero__fade"></div>
  </div>

  <div class="hero__content zf-container">
    <div class="hero__copy zf-reveal is-visible">
      <p class="zf-eyebrow">
        <span class="zf-badge">{t(locale, "hero.badge")}</span>
        <span class="hero__live">{t(locale, "hero.live")}</span>
      </p>
      <h1>{t(locale, "hero.headline")}</h1>
      <p class="hero__sub">{t(locale, "hero.subline")}</p>
      <StoreButtons locale={locale} />
    </div>
  </div>

  <div class="hero__stage zf-container zf-reveal is-visible" aria-hidden="false">
    <article class="hero-card">
      <div class="hero-card__icon" aria-hidden="true">
        <img src="/images/38EivRTUD86UdDi4ptLVvUiyP8_c131ca.svg" alt="" width="28" height="28" />
      </div>
      <p>Your best elevation yet!</p>
    </article>

    <div class="hero-phone">
      <img
        src="/images/NY1SOaCQ0vsywzcBUU0nUrogs_b56aad.png"
        alt=""
        width="390"
        height="844"
      />
    </div>

    <article class="hero-card hero-card--wide">
      <p class="hero-card__title">Today's ride: On track</p>
      <div class="hero-card__metrics">
        <span><i></i>47 km</span>
        <span><i></i>73%</span>
        <span><i></i>Good</span>
      </div>
    </article>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 3;
    color: white;
    overflow: visible;
    min-height: 92vh;
    min-height: 92dvh;
    padding-bottom: 0;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: 0 0 0 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 20, 25, 0.42) 0%, rgba(15, 20, 25, 0.12) 42%, rgba(15, 20, 25, 0.08) 58%),
      radial-gradient(ellipse at 50% 18%, transparent 0%, rgba(0, 0, 0, 0.22) 75%);
  }

  /* Soft white bleed into next section — same idea as live */
  .hero__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: min(48%, 340px);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.35) 35%,
      rgba(255, 255, 255, 0.82) 70%,
      #fff 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding: 7.5rem 0 2rem;
  }

  .hero__copy {
    text-align: center;
    max-width: 46rem;
    margin-inline: auto;
  }

  .hero__live {
    color: rgba(255, 255, 255, 0.92);
  }

  .hero h1 {
    margin: 1rem 0 0.85rem;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 700;
  }

  .hero__sub {
    margin: 0 auto 1.6rem;
    max-width: 34rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: rgba(255, 255, 255, 0.92);
  }

  .hero__stage {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: minmax(180px, 240px) minmax(220px, 280px) minmax(220px, 300px);
    gap: 1rem;
    align-items: end;
    justify-content: center;
    margin-top: 1.25rem;
    margin-bottom: -5.5rem;
  }

  .hero-card {
    background: rgba(28, 31, 34, 0.82);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    padding: 1.15rem 1.2rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
    color: #fff;
  }

  .hero-card__icon {
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: var(--zf-orange);
    margin-bottom: 0.85rem;
  }

  .hero-card__icon img {
    filter: brightness(0) invert(1);
  }

  .hero-card p {
    margin: 0;
    font-weight: 600;
  }

  .hero-card--wide .hero-card__title {
    margin-bottom: 0.9rem;
  }

  .hero-card__metrics {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.92rem;
  }

  .hero-card__metrics span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-card__metrics i {
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    display: inline-block;
  }

  .hero-phone {
    justify-self: center;
    width: min(100%, 280px);
    border-radius: 34px;
    overflow: hidden;
    background: #0b0d0f;
    border: 3px solid rgba(255, 255, 255, 0.92);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.35);
  }

  .hero-phone img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 900px) {
    .hero__stage {
      grid-template-columns: 1fr;
      justify-items: center;
      margin-bottom: -2.5rem;
    }

    .hero-card,
    .hero-card--wide {
      width: min(100%, 22rem);
    }

    .hero-phone {
      order: -1;
    }
  }
</style>
